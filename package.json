{
  "name": "openvigil-multi-agent-platform",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/run-vinext.mjs dev",
    "build": "vinext build",
    "start": "node scripts/run-vinext.mjs start",
    "test": "pnpm run build && pnpm run check:bundle && node --experimental-strip-types --test tests/*.test.mjs",
    "test:coverage": "pnpm run build && pnpm run check:bundle && node --experimental-strip-types --experimental-test-coverage --test-coverage-lines=89 --test-coverage-branches=49 --test-coverage-functions=32 --test tests/*.test.mjs",
    "pretest:e2e": "pnpm run build",
    "test:e2e": "playwright test",
    "test:e2e:real": "playwright test tests/e2e/real-cross-layer.spec.ts",
    "test:start-smoke": "node scripts/standard-start-smoke.mjs",
    "check:repository-artifacts": "node scripts/check-repository-artifacts.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "format": "prettier --write app build components db docs drizzle lib tests worker \"*.{js,mjs,cjs,jsx,ts,tsx,json,css,md,yml,yaml}\" backend/README.md backend/docker-compose.yml backend/ops backend/deploy",
    "format:check": "prettier --check app build components db docs drizzle lib tests worker \"*.{js,mjs,cjs,jsx,ts,tsx,json,css,md,yml,yaml}\" backend/README.md backend/docker-compose.yml backend/ops backend/deploy",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^9.1.2",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "echarts": "^6.1.0",
    "lucide-react": "^1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^5.20260811.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "axe-core": "4.11.4",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "prettier": "^3.9.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
