{
  "Statement": [
    {
      "Action": ["s3:GetBucketLocation"],
      "Effect": "Allow",
      "Resource": ["arn:aws:s3:::windops-care-benchmarks"]
    },
    {
      "Action": ["s3:ListBucket"],
      "Condition": {
        "StringLike": { "s3:prefix": ["care/v6/*"] }
      },
      "Effect": "Allow",
      "Resource": ["arn:aws:s3:::windops-care-benchmarks"]
    },
    {
      "Action": [
        "s3:AbortMultipartUpload",
        "s3:GetObject",
        "s3:ListMultipartUploadParts",
        "s3:PutObject"
      ],
      "Effect": "Allow",
      "Resource": ["arn:aws:s3:::windops-care-benchmarks/care/v6/*"]
    }
  ],
  "Version": "2012-10-17"
}
