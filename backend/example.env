# Safe example values only; copy to .env and replace every development credential.
WINDOPS_ENVIRONMENT=development
WINDOPS_BIND_HOST=127.0.0.1
WINDOPS_TRUSTED_HOSTS=["localhost","127.0.0.1"]
WINDOPS_MAX_REQUEST_BODY_BYTES=2097152
WINDOPS_RELEASE_ID=development
WINDOPS_RELEASE_COMMIT_SHA=
WINDOPS_RELEASE_IMAGE_DIGEST=
WINDOPS_DOCS_ENABLED=true
WINDOPS_RATE_LIMIT_ENABLED=false
WINDOPS_RATE_LIMIT_REQUESTS_PER_MINUTE=600
WINDOPS_RATE_LIMIT_CLIENT_REQUESTS_PER_MINUTE=10000
WINDOPS_DATABASE_URL=postgresql+asyncpg://windops:change-me@localhost:5432/windops
WINDOPS_REDIS_URL=redis://localhost:6379/0
WINDOPS_READ_AUDIT_STREAM_KEY=windops:read-audit:v2
WINDOPS_READ_AUDIT_CONSUMER_GROUP=windops-read-audit-writers-v2
WINDOPS_READ_AUDIT_STREAM_MAX_PENDING=100000
WINDOPS_READ_AUDIT_ENQUEUE_TIMEOUT_MS=250
WINDOPS_READ_AUDIT_BATCH_SIZE=500
WINDOPS_READ_AUDIT_WORKER_BLOCK_MS=2000
WINDOPS_READ_AUDIT_RECLAIM_IDLE_MS=60000
WINDOPS_READ_AUDIT_ARCHIVE_AFTER_DAYS=30
WINDOPS_READ_AUDIT_RETENTION_DAYS=365
WINDOPS_READ_AUDIT_MAINTENANCE_BATCH_SIZE=10000
WINDOPS_READ_AUDIT_PARTITION_MONTHS_AHEAD=3
WINDOPS_MINIO_ENDPOINT=localhost:9000
WINDOPS_MINIO_ACCESS_KEY=windops
WINDOPS_MINIO_SECRET_KEY=change-me
WINDOPS_MINIO_SECURE=false
WINDOPS_MINIO_PUBLIC_BASE=http://localhost:9000
WINDOPS_MINIO_FIELD_EVIDENCE_BUCKET=windops-field-evidence
WINDOPS_MINIO_KNOWLEDGE_BUCKET=windops-knowledge-documents
WINDOPS_MINIO_MODEL_BUCKET=windops-model-artifacts
WINDOPS_MINIO_TWIN_BUCKET=windops-twin-artifacts
WINDOPS_MINIO_CARE_BUCKET=windops-care-benchmarks
WINDOPS_MINIO_CARE_RAW_PREFIX=care/v6/raw
WINDOPS_MINIO_CARE_STANDARD_PREFIX=care/v6/standard
WINDOPS_MINIO_CARE_QUALITY_PREFIX=care/v6/quality
WINDOPS_MINIO_CARE_PREDICTIONS_PREFIX=care/v6/predictions
WINDOPS_MINIO_CARE_REPORTS_PREFIX=care/v6/reports
# Inference endpoints and credentials are operator-managed; database deployments
# reference only these target IDs and never persist tokens or arbitrary URLs.
WINDOPS_MODEL_INFERENCE_TARGETS={"predictive-primary":{"endpoint_url":"https://inference.example.invalid/v1/predict","api_token":"replace-with-independent-32-plus-character-model-token","timeout_seconds":15}}
WINDOPS_AGENT_MODE=deterministic
WINDOPS_LITELLM_MODEL=openai/gpt-5-mini
WINDOPS_LITELLM_TIMEOUT_SECONDS=45
WINDOPS_LITELLM_MAX_RETRIES=2
WINDOPS_LITELLM_MINIMUM_DIAGNOSIS_CONFIDENCE=0.5
WINDOPS_EMBEDDING_MODEL=text-embedding-3-small
# Production requires OTLP-over-HTTPS export and a dedicated Prometheus scrape token.
# Header values and the metrics token belong in a secret manager, never source control.
WINDOPS_OTEL_ENABLED=false
WINDOPS_OTEL_SERVICE_NAME=windops-backend
WINDOPS_OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.invalid/v1/traces
WINDOPS_OTEL_EXPORTER_OTLP_HEADERS={"Authorization":"replace-with-collector-authorization-value"}
WINDOPS_METRICS_BEARER_TOKEN=dev-metrics-token-replace-before-use
WINDOPS_SLO_HTTP_AVAILABILITY_TARGET=0.999
WINDOPS_SLO_HTTP_P95_LATENCY_SECONDS=2
WINDOPS_SLO_AGENT_SUCCESS_TARGET=0.99
WINDOPS_SLO_TELEMETRY_FRESHNESS_SECONDS=120
WINDOPS_KNOWLEDGE_GRAPH_BACKEND=neo4j
WINDOPS_NEO4J_URI=neo4j://localhost:7687
WINDOPS_NEO4J_USER=neo4j
WINDOPS_NEO4J_PASSWORD=change-me-neo4j
WINDOPS_NEO4J_DATABASE=neo4j
WINDOPS_KNOWLEDGE_GRAPH_REBUILD_ON_STARTUP=false
WINDOPS_KNOWLEDGE_GRAPH_PROJECTION_BATCH_SIZE=500
WINDOPS_KNOWLEDGE_GRAPH_PROJECTION_MAX_SOURCE_ROWS=250000
WINDOPS_KNOWLEDGE_GRAPH_PROJECTION_MAX_NODES=250000
WINDOPS_KNOWLEDGE_GRAPH_PROJECTION_MAX_RELATIONSHIPS=500000
WINDOPS_KNOWLEDGE_GRAPH_PROJECTION_MAX_SOURCE_MEGABYTES=512
WINDOPS_KNOWLEDGE_GRAPH_PROJECTION_MAX_GRAPH_MEGABYTES=256
WINDOPS_KNOWLEDGE_GRAPH_PROJECTION_MAX_MEMORY_MEGABYTES=256
WINDOPS_KNOWLEDGE_GRAPH_PROJECTION_MAX_RUNTIME_SECONDS=300
WINDOPS_SCHEMA_BOOTSTRAP=false
WINDOPS_DEMO_SEED=false
# Production human identity. Sites supplies stable authenticated-user IDs to the
# Worker, which exchanges them for a short-lived, request-bound delegation token.
WINDOPS_AUTH_MODE=static_tokens
WINDOPS_GATEWAY_DELEGATION_SECRET=replace-with-the-same-random-48-plus-character-worker-secret
# During rotation, keep the prior secret here until all in-flight 60-second tokens expire.
WINDOPS_GATEWAY_DELEGATION_PREVIOUS_SECRET=
WINDOPS_GATEWAY_DELEGATION_ISSUER=windops-sites-gateway
WINDOPS_GATEWAY_DELEGATION_AUDIENCE=windops-python-backend
WINDOPS_IDENTITY_ROLE_MAPPINGS={"stable-sites-user-id-1":["operations_manager","operations_approver"],"stable-sites-user-id-2":["maintenance_reviewer"],"stable-sites-user-id-3":["field_technician"]}
# Scope grants are independent from roles.  Keep them explicit; production
# business reads and writes fail closed when a delegated subject has no matching grant.
WINDOPS_IDENTITY_SCOPE_MAPPINGS={"stable-sites-user-id-1":{"tenant_ids":["tenant-east-china"],"wind_farm_ids":["WF-EAST-01"],"turbine_ids":["WT-023"],"data_scopes":["asset","alarm","telemetry","diagnosis","evidence","mission","decision","work_order","knowledge","resource","model","report","platform","agent","dashboard"],"allow_global":true},"stable-sites-user-id-2":{"tenant_ids":["tenant-east-china"],"wind_farm_ids":["WF-EAST-01"],"data_scopes":["asset","alarm","diagnosis","evidence","mission","decision","work_order","knowledge","dashboard"],"allow_global":true},"stable-sites-user-id-3":{"tenant_ids":["tenant-east-china"],"wind_farm_ids":["WF-EAST-01"],"turbine_ids":["WT-023"],"data_scopes":["asset","alarm","telemetry","diagnosis","evidence","mission","work_order","resource","dashboard"],"allow_global":false}}
WINDOPS_DELEGATION_CLOCK_SKEW_SECONDS=15
# Development-only shared SCADA credential. Production ignores this value and
# requires one distinct credential plus a governed policy per external source.
WINDOPS_SCADA_INGEST_API_KEY=dev-scada-key-replace-before-use-0001
WINDOPS_INGEST_SOURCE_API_KEYS={"offshore-opcua-01":"replace-with-independent-32-plus-character-source-secret"}
WINDOPS_TELEMETRY_SOURCE_POLICIES={"offshore-opcua-01":{"display_name":"Offshore OPC UA gateway 01","source_kind":"opcua","enabled":true,"sequence_required":true,"max_lateness_seconds":300,"max_future_skew_seconds":120,"expected_heartbeat_seconds":60,"allowed_turbines":["WT-023"],"allowed_variables":["main_bearing_vibration_rms"],"variable_contracts":{"main_bearing_vibration_rms":{"label":"Main bearing vibration RMS","unit":"mm/s","precision":2,"normal_min":0,"normal_max":4.5,"threshold_direction":"above","warning_threshold":4.5,"critical_threshold":7.1}}}}
WINDOPS_EVENT_STREAM_POLL_MILLISECONDS=1000
WINDOPS_EVENT_STREAM_CONNECTION_SECONDS=25
# Governed outbound work-order publication and inbound status callbacks.
WINDOPS_EAM_ENABLED=false
WINDOPS_EAM_BASE_URL=https://eam.example.invalid/api/v1
WINDOPS_EAM_API_TOKEN=replace-with-independent-32-plus-character-outbound-token
WINDOPS_EAM_WEBHOOK_API_KEY=replace-with-independent-32-plus-character-inbound-token
WINDOPS_EAM_TIMEOUT_SECONDS=10
# Development-only human role credentials. Production human requests use Sites delegation.
WINDOPS_OPERATIONS_APPROVER_API_KEY=dev-approver-key-replace-before-use-01
WINDOPS_MAINTENANCE_REVIEWER_API_KEY=dev-reviewer-key-replace-before-use-01
WINDOPS_OPERATIONS_MANAGER_API_KEY=dev-manager-key-replace-before-use-001
WINDOPS_FIELD_TECHNICIAN_API_KEY=dev-field-key-replace-before-use-0001
WINDOPS_TEST_AUTH_BYPASS_ENABLED=false
