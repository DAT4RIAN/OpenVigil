# Safe example values only; copy to .env and replace every development credential.
WINDOPS_ENVIRONMENT=development
WINDOPS_DATABASE_URL=postgresql+asyncpg://windops:change-me@localhost:5432/windops
WINDOPS_REDIS_URL=redis://localhost:6379/0
WINDOPS_MINIO_ENDPOINT=localhost:9000
WINDOPS_MINIO_ACCESS_KEY=windops
WINDOPS_MINIO_SECRET_KEY=change-me
WINDOPS_MINIO_SECURE=false
WINDOPS_MINIO_PUBLIC_BASE=http://localhost:9000
WINDOPS_AGENT_MODE=deterministic
WINDOPS_LITELLM_MODEL=openai/gpt-5-mini
WINDOPS_EMBEDDING_MODEL=text-embedding-3-small
WINDOPS_SCHEMA_BOOTSTRAP=false
WINDOPS_DEMO_SEED=false
# Development-only role credentials. Generate independent >=32-character random
# values for every production deployment; the application rejects these examples.
WINDOPS_SCADA_INGEST_API_KEY=dev-scada-key-replace-before-use-0001
WINDOPS_OPERATIONS_APPROVER_API_KEY=dev-approver-key-replace-before-use-01
WINDOPS_MAINTENANCE_REVIEWER_API_KEY=dev-reviewer-key-replace-before-use-01
WINDOPS_OPERATIONS_MANAGER_API_KEY=dev-manager-key-replace-before-use-001
WINDOPS_FIELD_TECHNICIAN_API_KEY=dev-field-key-replace-before-use-0001
WINDOPS_TEST_AUTH_BYPASS_ENABLED=false
