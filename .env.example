# Copy this file to .env for local development. Never put real credentials in
# this template or commit the resulting .env file.

# OpenVigil runtime. Demo is the safe local default.
WINDOPS_RUNTIME_MODE=demo

# Required only when WINDOPS_RUNTIME_MODE=production.
WINDOPS_BACKEND_BASE_URL=http://127.0.0.1:8000
WINDOPS_BACKEND_AUTH_MODE=sites_delegation
WINDOPS_BACKEND_DELEGATION_SECRET=replace-with-the-same-random-48-plus-character-backend-secret
WINDOPS_BACKEND_EXPECTED_RELEASE_ID=replace-with-approved-release-id
WINDOPS_BACKEND_EXPECTED_COMMIT_SHA=replace-with-approved-full-commit-sha
WINDOPS_BACKEND_EXPECTED_IMAGE_DIGEST=sha256:replace-with-approved-image-digest
WINDOPS_BACKEND_API_TOKEN=replace-with-a-configured-windops-role-token
WINDOPS_BACKEND_REQUEST_TIMEOUT_MS=8000

# QWeather current weather. Obtain the account-specific API Host from
# QWeather Console > Settings. API requests use X-QW-Api-Key server-side.
WINDOPS_QWEATHER_API_HOST=replace-with-account-host.xy.qweatherapi.com
WINDOPS_QWEATHER_DEVELOPER_ID=replace-with-developer-id
WINDOPS_QWEATHER_CREDENTIAL_ID=replace-with-credential-id
WINDOPS_QWEATHER_API_KEY=replace-with-api-key

# Fixed display location: Nanjing.
WINDOPS_WEATHER_LOCATION_NAME=南京
WINDOPS_WEATHER_LATITUDE=32.06
WINDOPS_WEATHER_LONGITUDE=118.80
WINDOPS_WEATHER_REFRESH_SECONDS=600
WINDOPS_WEATHER_STALE_SECONDS=1800
WINDOPS_WEATHER_TIMEOUT_MS=5000
